# Backend root URL only. Do not append /api; API clients already call /api/... paths.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_DATA_SOURCE=real

# Demo login button on /login: "true" shows it, "false" hides it.
# Unset: shown in development, hidden in production builds.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
# Demo account role: ROLE_ADMIN only when "true" (opens /admin with demo data). Default ROLE_USER.
NEXT_PUBLIC_DEMO_ADMIN=false
