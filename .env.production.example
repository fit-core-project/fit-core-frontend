# Backend root URL only. Do not append /api; API clients already call /api/... paths.
NEXT_PUBLIC_API_BASE_URL=https://<BE_DUCKDNS_OR_VM_DOMAIN>
NEXT_PUBLIC_BASE_URL=https://<BE_DUCKDNS_OR_VM_DOMAIN>
NEXT_PUBLIC_APP_ENV=prod

# Demo login button on /login. Hidden in production unless this is exactly "true".
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# Demo account role: ROLE_ADMIN only when "true". Keep false in production.
NEXT_PUBLIC_DEMO_ADMIN=false
